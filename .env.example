GEMINI_API_KEY=your-free-key-from-aistudio.google.com
# Leave empty to use embedded local Qdrant (no Docker, no account). Fill for Qdrant Cloud free tier or docker-compose:
QDRANT_URL=
QDRANT_API_KEY=
# true = deterministic offline stubs instead of Gemini
# Model alias that worked on the free tier (gemini-2.5-flash returned 404 on some keys):
GEMINI_MODEL=gemini-flash-latest
MOCK_MODE=false
